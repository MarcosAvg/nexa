{
    "name": "nexa",
    "version": "0.1.0",
    "type": "module",
    "description": "Plataforma de control de accesos, gestión de personal y auditoría (Svelte 5 + Supabase).",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/TU-USUARIO/nexa.git"
    },
    "keywords": [
        "svelte",
        "supabase",
        "control-accesos",
        "personal",
        "auditoria",
        "pwa",
        "tailwind"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "postbuild": "node scripts/generate-build-info.js",
        "predev": "node scripts/generate-build-info.js && node scripts/generate-modules.mjs",
        "preview": "vite preview",
        "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
        "prebuild": "node scripts/generate-modules.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "playwright test",
        "db:setup": "bash scripts/db-setup.sh",
        "db:reset": "bash scripts/db-setup.sh --reset",
        "smoke:contract": "esbuild scripts/smoke-media-contract.ts --bundle --platform=node --format=esm --outfile=.smoke.mjs && node .smoke.mjs; rm -f .smoke.mjs"
    },
    "devDependencies": {
        "@playwright/test": "^1.58.2",
        "@sveltejs/vite-plugin-svelte": "^6.2.1",
        "@tsconfig/svelte": "^5.0.6",
        "@types/file-saver": "^2.0.7",
        "@types/node": "^24.11.0",
        "dotenv": "^17.3.1",
        "lucide-svelte": "^0.563.0",
        "prettier": "^3.9.6",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte": "^5.43.8",
        "svelte-check": "^4.3.4",
        "typescript": "~5.9.3",
        "vite": "^7.2.4",
        "vite-plugin-pwa": "^1.2.0"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.98.0",
        "@tailwindcss/vite": "^4.1.18",
        "@types/jspdf": "^1.3.3",
        "chart.js": "^4.5.1",
        "exceljs": "^4.4.0",
        "file-saver": "^2.0.5",
        "idb-keyval": "^6.2.2",
        "jspdf": "^4.2.0",
        "svelte-sonner": "^1.0.7",
        "svelte-spa-router": "^4.0.1",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.1.18",
        "zod": "^4.3.6"
    }
}
